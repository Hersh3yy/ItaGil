# itamargilboa.com — environment
# Copy to `.env` and fill in. Nothing here is committed.

# --- Contact form (Resend) ---
# Required for the contact form to send. Without it, /api/send-email returns 500.
RESEND_API_KEY=
# Optional overrides; both default to gilboaitamar@gmail.com.
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# --- CMS (VAMS) ---
# Content (biography, news, projects, slideshow) comes from VAMS, read on the
# server by server/api/cms/[type].get.js. The key is Itamar's VAMS API key
# (the api_key on his VAMS user). Without it every content request fails with 401.
NUXT_CMS_API_KEY=
# Optional. Defaults to the production VAMS.
# NUXT_CMS_BASE_URL=https://app.use-vams.me
