# itamargilboa.com — environment
# Copy to `.env` and fill in. Nothing here is committed.

# --- Contact form (Resend) ---
# Required for the contact form to send. Without it, /api/send-email returns 500.
RESEND_API_KEY=
# Optional overrides; both default to gilboaitamar@gmail.com.
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# --- CMS base URL ---
# Where the site reads its content (biography, news, projects, slideshow).
# Defaults to the live Strapi on DigitalOcean if unset, so the site works as-is.
# To point the whole app at VAMS instead, set this to the VAMS API base.
#   NOTE: VAMS must first hold Itamar's content (entry types: ig-biography,
#   news-articles, ig-projects, ig-landing-page-slideshow-images) AND the fetch
#   code needs a response-shape adapter — Strapi returns { data: { attributes } },
#   VAMS does not. Until then, leave this on Strapi. See PROJECT.md → roadmap f7.
# NUXT_PUBLIC_CMS_BASE_URL=https://hiren-devs-strapi-j5h2f.ondigitalocean.app
